<odoo>
    <record id="view_association_membership_application_list" model="ir.ui.view">
        <field name="name">association.membership.application.list</field>
        <field name="model">association.membership.application</field>
        <field name="arch" type="xml">
            <list string="Membership Applications"
                  decoration-info="state == 'submitted'"
                  decoration-warning="state in ('under_verification', 'payment_pending')"
                  decoration-success="state == 'approved'"
                  decoration-danger="state in ('rejected', 'cancelled')">
                <field name="name"/>
                <field name="applicant_name"/>
                <field name="mobile"/>
                <field name="email"/>
                <field name="membership_type_id"/>
                <field name="application_date"/>
                <field name="payment_status"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_association_membership_application_form" model="ir.ui.view">
        <field name="name">association.membership.application.form</field>
        <field name="model">association.membership.application</field>
        <field name="arch" type="xml">
            <form string="Membership Application">
                <header>
                    <button name="action_submit" string="Submit" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start_verification" string="Start Verification" type="object"
                            class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_request_correction" string="Request Correction" type="object"
                            invisible="state != 'under_verification'"/>
                    <button name="action_send_for_payment" string="Send for Payment" type="object"
                            class="btn-primary" invisible="state != 'under_verification'"/>
                    <button name="action_mark_payment_received" string="Record Payment Received" type="object"
                            class="btn-primary" invisible="state != 'payment_pending'"/>
                    <button name="action_approve" string="Approve" type="object"
                            class="btn-success" invisible="state not in ('under_verification', 'payment_received')"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state in ('approved', 'rejected', 'cancelled')"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('approved', 'cancelled')"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            invisible="state == 'draft'" groups="association_membership.group_membership_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,under_verification,payment_pending,payment_received,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_payments" type="object" class="oe_stat_button" icon="fa-money">
                            <field name="payment_count" widget="statinfo" string="Payments"/>
                        </button>
                    </div>
                    <field name="photo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="applicant_name" placeholder="Applicant Full Name"/></h1>
                        <h3><field name="name" readonly="1"/></h3>
                    </div>
                    <group>
                        <group string="Contact">
                            <field name="mobile"/>
                            <field name="whatsapp"/>
                            <field name="email"/>
                            <field name="date_of_birth"/>
                            <field name="gender"/>
                            <field name="blood_group"/>
                            <field name="nationality_id"/>
                            <field name="job"/>
                        </group>
                        <group string="Membership">
                            <field name="membership_type_id"/>
                            <field name="membership_category"/>
                            <field name="referral_reference" readonly="1"/>
                            <field name="referral_member_id"/>
                            <field name="application_date"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="member_id" readonly="1"/>
                            <field name="membership_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Payment">
                            <field name="currency_id" invisible="1"/>
                            <field name="payment_status" readonly="1"/>
                            <field name="amount_due"/>
                            <field name="amount_paid"/>
                            <field name="balance_due"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="KSA Residency">
                            <group>
                                <group>
                                    <field name="iqama_number"/>
                                    <field name="passport_number"/>
                                </group>
                                <group>
                                    <field name="ksa_province"/>
                                    <field name="ksa_area"/>
                                </group>
                            </group>
                        </page>
                        <page string="Address in India">
                            <group>
                                <group>
                                    <field name="house_address"/>
                                    <field name="street"/>
                                    <field name="place"/>
                                    <field name="district"/>
                                </group>
                                <group>
                                    <field name="state_id"/>
                                    <field name="country_id"/>
                                    <field name="pin_code"/>
                                </group>
                            </group>
                        </page>
                        <page string="Professional">
                            <group>
                                <field name="occupation"/>
                                <field name="company_name"/>
                                <field name="designation"/>
                                <field name="work_address"/>
                            </group>
                        </page>
                        <page string="Identity Documents">
                            <group>
                                <field name="id_proof_type"/>
                                <field name="id_proof_number"/>
                                <field name="id_proof_document" filename="id_proof_document_name"/>
                                <field name="id_proof_document_name" invisible="1"/>
                            </group>
                        </page>
                        <page string="Emergency Contact">
                            <group>
                                <field name="emergency_contact_name"/>
                                <field name="emergency_contact_relationship"/>
                                <field name="emergency_contact_mobile"/>
                            </group>
                        </page>
                        <page string="Verification &amp; Notes">
                            <group>
                                <field name="verification_notes"/>
                                <field name="rejection_reason"/>
                                <field name="additional_info"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_association_membership_application_search" model="ir.ui.view">
        <field name="name">association.membership.application.search</field>
        <field name="model">association.membership.application</field>
        <field name="arch" type="xml">
            <search string="Membership Applications">
                <field name="name"/>
                <field name="applicant_name"/>
                <field name="mobile"/>
                <field name="email"/>
                <field name="iqama_number"/>
                <field name="passport_number"/>
                <field name="membership_type_id"/>
                <filter string="Draft" name="state_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="state_submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Under Verification" name="state_verification" domain="[('state', '=', 'under_verification')]"/>
                <filter string="Payment Pending" name="state_payment_pending" domain="[('state', '=', 'payment_pending')]"/>
                <filter string="Approved" name="state_approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="state_rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter string="Fee Pending" name="fee_pending" domain="[('payment_status', '=', 'pending')]"/>
                <filter string="Fee Paid" name="fee_paid" domain="[('payment_status', '=', 'paid')]"/>
                <group>
                    <filter string="Membership Type" name="group_membership_type" context="{'group_by': 'membership_type_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Application Date" name="group_date" context="{'group_by': 'application_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_association_membership_application" model="ir.actions.act_window">
        <field name="name">Membership Applications</field>
        <field name="res_model">association.membership.application</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No membership applications yet
            </p>
            <p>
                Applications submitted through the website (Phase 2) or created manually will appear here.
            </p>
        </field>
    </record>
</odoo>
