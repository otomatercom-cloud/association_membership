<odoo>
    <record id="view_association_member_list" model="ir.ui.view">
        <field name="name">association.member.list</field>
        <field name="model">association.member</field>
        <field name="arch" type="xml">
            <list string="Members"
                  decoration-success="status == 'active'"
                  decoration-muted="status in ('expired', 'cancelled')"
                  decoration-warning="status == 'suspended'">
                <field name="member_number"/>
                <field name="name"/>
                <field name="mobile"/>
                <field name="email"/>
                <field name="membership_type_id"/>
                <field name="joining_date"/>
                <field name="membership_expiry_date"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_association_member_form" model="ir.ui.view">
        <field name="name">association.member.form</field>
        <field name="model">association.member</field>
        <field name="arch" type="xml">
            <form string="Member">
                <header>
                    <button name="action_suspend" string="Suspend" type="object" invisible="status != 'active'"/>
                    <button name="action_reactivate" string="Reactivate" type="object"
                            class="btn-primary" invisible="status != 'suspended'"/>
                    <button name="action_cancel" string="Cancel Membership" type="object"
                            invisible="status == 'cancelled'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,active,expired,suspended,cancelled"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <field name="photo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                        <h3><field name="member_number" readonly="1"/></h3>
                    </div>
                    <group>
                        <group string="Contact">
                            <field name="partner_id"/>
                            <field name="mobile"/>
                            <field name="whatsapp"/>
                            <field name="email"/>
                            <field name="date_of_birth"/>
                            <field name="gender"/>
                            <field name="blood_group"/>
                            <field name="job"/>
                        </group>
                        <group string="Membership">
                            <field name="membership_type_id"/>
                            <field name="joining_date"/>
                            <field name="membership_start_date" readonly="1"/>
                            <field name="membership_expiry_date" readonly="1"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="KSA Residency">
                            <field name="iqama_number"/>
                            <field name="passport_number"/>
                            <field name="ksa_province"/>
                            <field name="ksa_area"/>
                        </group>
                        <group string="Address in India">
                            <field name="street"/>
                            <field name="city"/>
                            <field name="state_id"/>
                            <field name="country_id"/>
                            <field name="zip"/>
                        </group>
                    </group>
                    <group>
                        <group string="Professional">
                            <field name="occupation"/>
                            <field name="company_name"/>
                            <field name="designation"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Identity Documents">
                            <group>
                                <field name="id_proof_type"/>
                                <field name="id_proof_number"/>
                                <field name="id_proof_document" filename="id_proof_document_name"/>
                                <field name="id_proof_document_name" invisible="1"/>
                            </group>
                        </page>
                        <page string="Membership History">
                            <field name="membership_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="membership_type_id"/>
                                    <field name="start_date"/>
                                    <field name="expiry_date"/>
                                    <field name="fee"/>
                                    <field name="payment_status"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_association_member_search" model="ir.ui.view">
        <field name="name">association.member.search</field>
        <field name="model">association.member</field>
        <field name="arch" type="xml">
            <search string="Members">
                <field name="member_number"/>
                <field name="name"/>
                <field name="mobile"/>
                <field name="email"/>
                <field name="iqama_number"/>
                <field name="passport_number"/>
                <field name="membership_type_id"/>
                <filter string="Active" name="status_active" domain="[('status', '=', 'active')]"/>
                <filter string="Expired" name="status_expired" domain="[('status', '=', 'expired')]"/>
                <filter string="Suspended" name="status_suspended" domain="[('status', '=', 'suspended')]"/>
                <filter string="Cancelled" name="status_cancelled" domain="[('status', '=', 'cancelled')]"/>
                <group>
                    <filter string="Membership Type" name="group_type" context="{'group_by': 'membership_type_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Expiry Date" name="group_expiry" context="{'group_by': 'membership_expiry_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_association_member" model="ir.actions.act_window">
        <field name="name">Members</field>
        <field name="res_model">association.member</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_status_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No members yet
            </p>
            <p>
                Members are created automatically when a membership application is approved.
            </p>
        </field>
    </record>
</odoo>
