<odoo>
    <record id="view_association_membership_type_list" model="ir.ui.view">
        <field name="name">association.membership.type.list</field>
        <field name="model">association.membership.type</field>
        <field name="arch" type="xml">
            <list string="Membership Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="membership_fee"/>
                <field name="renewal_fee"/>
                <field name="duration"/>
                <field name="duration_unit"/>
                <field name="requires_approval"/>
                <field name="digital_card_enabled"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_association_membership_type_form" model="ir.ui.view">
        <field name="name">association.membership.type.form</field>
        <field name="model">association.membership.type</field>
        <field name="arch" type="xml">
            <form string="Membership Type">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. General Member"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="duration"/>
                            <field name="duration_unit"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="membership_fee"/>
                            <field name="renewal_fee"/>
                            <field name="joining_fee"/>
                            <field name="tax_percentage"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="requires_approval"/>
                            <field name="digital_card_enabled"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Describe this membership type..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_association_membership_type_search" model="ir.ui.view">
        <field name="name">association.membership.type.search</field>
        <field name="model">association.membership.type</field>
        <field name="arch" type="xml">
            <search string="Membership Types">
                <field name="name"/>
                <field name="code"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Requires Approval" name="requires_approval" domain="[('requires_approval', '=', True)]"/>
                <group>
                    <filter string="Duration Unit" name="group_duration_unit" context="{'group_by': 'duration_unit'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_association_membership_type" model="ir.actions.act_window">
        <field name="name">Membership Types</field>
        <field name="res_model">association.membership.type</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first membership type
            </p>
            <p>
                Define the types of membership your association offers, such as General, Life,
                Student or Corporate Member, along with their fee and validity period.
            </p>
        </field>
    </record>
</odoo>
