<odoo>

    <template id="membership_verify_page" name="Membership Card Verification">
        <t t-call="website.layout">
            <div id="ms_verify_page" class="container my-5" style="max-width: 640px;">
                <t t-if="not member">
                    <div class="text-center py-5">
                        <i class="fa fa-exclamation-triangle fa-3x text-warning mb-3"/>
                        <h2>Card Not Recognized</h2>
                        <p class="text-muted">
                            This verification link is invalid or has expired. Please ask the cardholder
                            for a fresh card, or contact the association directly.
                        </p>
                    </div>
                </t>

                <t t-if="member">
                    <t t-set="status_map" t-value="{
                        'active': ('success', 'Active Member'),
                        'expired': ('danger', 'Membership Expired'),
                        'suspended': ('warning', 'Membership Suspended'),
                        'cancelled': ('danger', 'Membership Cancelled'),
                        'inactive': ('secondary', 'Not Yet Active'),
                    }"/>
                    <t t-set="status_color" t-value="status_map.get(member.card_status, ('secondary', 'Unknown'))[0]"/>
                    <t t-set="status_label" t-value="status_map.get(member.card_status, ('secondary', 'Unknown'))[1]"/>

                    <div class="card shadow-sm" style="overflow:hidden;">
                        <div t-attf-style="background: linear-gradient(135deg, #5b2a86 0%, #7c3aed 45%, #2563eb 100%); color:#fff; padding: 24px 16px; text-align:center;">
                            <img t-if="member.photo" t-att-src="image_data_uri(member.photo)"
                                 class="rounded-circle mb-2" style="width:100px;height:100px;object-fit:cover;border:3px solid rgba(255,255,255,0.7);"/>
                            <h3 class="mb-0" t-esc="member.name"/>
                            <div class="small" style="opacity:0.9;" t-esc="member.member_number"/>
                        </div>
                        <div t-attf-class="text-center py-2 text-bg-{{status_color}}">
                            <i t-attf-class="fa {{ 'fa-check-circle' if member.card_status == 'active' else 'fa-times-circle' }} me-1"/>
                            <strong t-esc="status_label"/>
                        </div>
                        <div class="card-body">
                            <table class="table table-borderless table-sm mb-0">
                                <tr>
                                    <td class="text-muted" style="width:40%;">Membership Type</td>
                                    <td><strong t-esc="member.membership_type_id.name"/></td>
                                </tr>
                                <tr t-if="member.job">
                                    <td class="text-muted">Job</td>
                                    <td t-esc="member.job"/>
                                </tr>
                                <tr t-if="member.city or member.state_id">
                                    <td class="text-muted">Place</td>
                                    <td>
                                        <t t-if="member.city" t-esc="member.city"/>
                                        <t t-if="member.city and member.state_id">, </t>
                                        <t t-if="member.state_id" t-esc="member.state_id.name"/>
                                    </td>
                                </tr>
                                <tr t-if="member.mobile">
                                    <td class="text-muted">Mobile</td>
                                    <td t-esc="member.mobile"/>
                                </tr>
                                <tr t-if="member.email">
                                    <td class="text-muted">Email</td>
                                    <td t-esc="member.email"/>
                                </tr>
                                <tr t-if="member.current_membership_id.start_date">
                                    <td class="text-muted">Valid</td>
                                    <td>
                                        <span t-esc="member.current_membership_id.start_date"/> to
                                        <span t-esc="member.current_membership_id.expiry_date"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    <p class="text-muted text-center small mt-3">
                        Identity document numbers and postal address are never shown on this public page.
                    </p>
                </t>
            </div>
        </t>
    </template>

</odoo>
