<odoo>
    <record id="view_association_membership_list" model="ir.ui.view">
        <field name="name">association.membership.list</field>
        <field name="model">association.membership</field>
        <field name="arch" type="xml">
            <list string="Memberships"
                  decoration-success="state == 'active'"
                  decoration-muted="state in ('expired', 'cancelled')"
                  decoration-warning="state == 'suspended'">
                <field name="name"/>
                <field name="member_id"/>
                <field name="membership_type_id"/>
                <field name="start_date"/>
                <field name="expiry_date"/>
                <field name="fee"/>
                <field name="payment_status"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_association_membership_form" model="ir.ui.view">
        <field name="name">association.membership.form</field>
        <field name="model">association.membership</field>
        <field name="arch" type="xml">
            <form string="Membership">
                <header>
                    <button name="action_activate" string="Activate" type="object"
                            class="btn-primary" invisible="state not in ('draft', 'suspended')"/>
                    <button name="action_suspend" string="Suspend" type="object" invisible="state != 'active'"/>
                    <button name="action_expire" string="Mark Expired" type="object" invisible="state != 'active'"/>
                    <button name="action_renew" string="Renew" type="object"
                            class="btn-primary" invisible="state not in ('active', 'expired')"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,expired,suspended,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_payments" type="object" class="oe_stat_button" icon="fa-money">
                            <field name="payment_count" widget="statinfo" string="Payments"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="member_id"/>
                            <field name="membership_type_id"/>
                            <field name="application_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="expiry_date"/>
                            <field name="activation_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="fee"/>
                            <field name="renewal_fee"/>
                            <field name="payment_status"/>
                        </group>
                        <group>
                            <field name="previous_membership_id" readonly="1"/>
                            <field name="renewal_membership_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Cancellation" invisible="state != 'cancelled'">
                        <field name="cancellation_date" readonly="1"/>
                        <field name="cancellation_reason"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_association_membership_search" model="ir.ui.view">
        <field name="name">association.membership.search</field>
        <field name="model">association.membership</field>
        <field name="arch" type="xml">
            <search string="Memberships">
                <field name="name"/>
                <field name="member_id"/>
                <field name="membership_type_id"/>
                <filter string="Active" name="state_active" domain="[('state', '=', 'active')]"/>
                <filter string="Expired" name="state_expired" domain="[('state', '=', 'expired')]"/>
                <filter string="Suspended" name="state_suspended" domain="[('state', '=', 'suspended')]"/>
                <filter string="Cancelled" name="state_cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Fee Pending" name="fee_pending" domain="[('payment_status', '=', 'pending')]"/>
                <filter string="Fee Paid" name="fee_paid" domain="[('payment_status', '=', 'paid')]"/>
                <group>
                    <filter string="Membership Type" name="group_type" context="{'group_by': 'membership_type_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Expiry Date" name="group_expiry" context="{'group_by': 'expiry_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_association_membership" model="ir.actions.act_window">
        <field name="name">Memberships</field>
        <field name="res_model">association.membership</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_state_active': 1}</field>
    </record>
</odoo>
