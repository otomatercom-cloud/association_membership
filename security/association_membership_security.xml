<odoo>
    <data>
        <record id="module_category_association_membership" model="ir.module.category">
            <field name="name">Association Membership</field>
            <field name="sequence">20</field>
        </record>

        <record id="module_privilege_association_membership" model="res.groups.privilege">
            <field name="name">Association Membership</field>
            <field name="category_id" ref="module_category_association_membership"/>
        </record>

        <record id="group_membership_staff" model="res.groups">
            <field name="name">Membership Staff</field>
            <field name="privilege_id" ref="module_privilege_association_membership"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">View and process membership applications; read-only on Members and Memberships.</field>
        </record>

        <record id="group_membership_manager" model="res.groups">
            <field name="name">Membership Manager</field>
            <field name="privilege_id" ref="module_privilege_association_membership"/>
            <field name="implied_ids" eval="[(4, ref('group_membership_staff'))]"/>
            <field name="comment">Manage applications, members, memberships and payments.</field>
        </record>

        <record id="group_membership_admin" model="res.groups">
            <field name="name">Membership Administrator</field>
            <field name="privilege_id" ref="module_privilege_association_membership"/>
            <field name="implied_ids" eval="[(4, ref('group_membership_manager'))]"/>
            <field name="comment">Full access, including Membership Types configuration.</field>
        </record>

        <!-- Multi-company record rules: a record with no company, or matching
             one of the user's allowed companies, is visible. Applies to all
             users regardless of group (no groups field = global rule). -->
        <record id="rule_membership_application_multi_company" model="ir.rule">
            <field name="name">Membership Application: multi-company</field>
            <field name="model_id" ref="model_association_membership_application"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_member_multi_company" model="ir.rule">
            <field name="name">Member: multi-company</field>
            <field name="model_id" ref="model_association_member"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_membership_multi_company" model="ir.rule">
            <field name="name">Membership: multi-company</field>
            <field name="model_id" ref="model_association_membership"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_membership_payment_multi_company" model="ir.rule">
            <field name="name">Membership Payment: multi-company</field>
            <field name="model_id" ref="model_association_membership_payment"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
