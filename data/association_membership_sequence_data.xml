<odoo>
    <data noupdate="1">
        <record id="seq_association_membership_application" model="ir.sequence">
            <field name="name">Association Membership Application</field>
            <field name="code">association.membership.application</field>
            <field name="prefix">APP/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_association_member" model="ir.sequence">
            <field name="name">Association Member</field>
            <field name="code">association.member</field>
            <field name="prefix">ASM/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_association_membership" model="ir.sequence">
            <field name="name">Association Membership</field>
            <field name="code">association.membership</field>
            <field name="prefix">ASM-MEM-%(year)s-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
